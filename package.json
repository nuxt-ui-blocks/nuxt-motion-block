{
  "name": "nuxt-motion-block",
  "version": "0.0.8",
  "description": "A streamlined UI library that extends Nuxt UI with motion capabilities powered by motion-v",
  "repository": "nuxt-ui-blocks/nuxt-motion-block",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs",
      "style": "./dist/runtime/tailwind.css"
    },
    "./types": {
      "types": "./dist/runtime/types/index.d.ts",
      "import": "./dist/runtime/types/index.js"
    },
    "./runtime/theme": {
      "types": "./dist/runtime/theme/index.d.ts",
      "import": "./dist/runtime/theme/index.js"
    },
    "./runtime/composables/useMotionBlockUI": {
      "types": "./dist/runtime/composables/useMotionBlockUI.d.ts",
      "import": "./dist/runtime/composables/useMotionBlockUI.js"
    },
    "./runtime/composables/useThemeColor": {
      "types": "./dist/runtime/composables/useThemeColor.d.ts",
      "import": "./dist/runtime/composables/useThemeColor.js"
    },
    "./runtime/utils/theme-color": {
      "types": "./dist/runtime/utils/theme-color.d.ts",
      "import": "./dist/runtime/utils/theme-color.js"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ],
      "types": [
        "./dist/runtime/types/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "bin",
    "docs/content"
  ],
  "bin": {
    "nuxt-motion-block-mcp": "./bin/mcp-server.mjs"
  },
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "pnpm dev:prepare && nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "release": "pnpm lint && pnpm test && pnpm prepack && changelogen --release && npm publish && git push --follow-tags",
    "lint": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit",
    "docs:dev": "pnpm --filter nuxt-motion-block-docs dev",
    "docs:build": "pnpm --filter nuxt-motion-block-docs build",
    "docs:preview": "pnpm --filter nuxt-motion-block-docs preview"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@nuxt/ui": "^4.11.2",
    "@vueuse/core": "^14.4.0",
    "defu": "^6.1.4",
    "embla-carousel-auto-height": "^8.6.0",
    "embla-carousel-auto-scroll": "^8.6.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-class-names": "^8.6.0",
    "embla-carousel-fade": "^8.6.0",
    "embla-carousel-vue": "^8.6.0",
    "embla-carousel-wheel-gestures": "^8.1.0",
    "motion-v": "^2.4.4",
    "reka-ui": "2.10.4",
    "shiki": "^3.0.0",
    "simplex-noise": "^4.0.3",
    "tailwind-variants": "^3.2.2",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "@nuxt/ui": ">=4.11.2",
    "motion-v": ">=2.4.4",
    "nuxt": "^4.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.4.2",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/kit": "^4.5.2",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.5.2",
    "@nuxt/test-utils": "^3.23.0",
    "@types/node": "latest",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.4.6",
    "changelogen": "^0.6.2",
    "eslint": "^9.39.4",
    "jsdom": "^27.2.0",
    "nuxt": "^4.5.2",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.3.11"
  },
  "resolutions": {
    "unimport": "4.1.1"
  },
  "pnpm": {
    "only-built-dependencies": [
      "@parcel/watcher",
      "@tailwindcss/oxide",
      "better-sqlite3",
      "esbuild",
      "sharp",
      "unrs-resolver",
      "vue-demi"
    ],
    "ignoredBuiltDependencies": [
      "@parcel/watcher",
      "@tailwindcss/oxide",
      "better-sqlite3",
      "esbuild",
      "sharp",
      "unrs-resolver",
      "vue-demi"
    ]
  }
}
